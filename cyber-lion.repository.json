{
  "schema_version": "1.0.0",
  "repository": {
    "id": "DonkeyJJLove/sbom",
    "url": "https://github.com/DonkeyJJLove/sbom",
    "owner": "DonkeyJJLove",
    "default_branch": "main",
    "vcs_ref": null
  },
  "cyber_lion": {
    "tile_id": "provenance.sbom",
    "roles": [
      "SupplyChainEvidenceProvider",
      "ArtifactIdentityProvider",
      "CompositionIntelligence"
    ],
    "layers": [
      "INF",
      "SEM",
      "MAND"
    ],
    "disposition": [
      "KEEP",
      "REFINE",
      "INTEGRATE"
    ]
  },
  "capabilities": [
    "artifact.identify",
    "sbom.observe",
    "supply_chain.scan",
    "artifact.delta",
    "provenance.emit",
    "composition.risk_evidence"
  ],
  "authority": {
    "maximum_level": "read",
    "required_gates": [
      "cyber-lion.mand"
    ]
  },
  "observability": {
    "logs": [
      "aid.event",
      "sbom.event",
      "scan.event",
      "delta.event"
    ],
    "metrics": [
      "component.count",
      "delta.count",
      "finding.count",
      "provenance.coverage"
    ],
    "traces": [
      "source→AID→SBOM/scan→delta→evidence"
    ]
  },
  "security": {
    "trust_boundaries": [
      "measurement != authority",
      "legacy gate event name != Cyber-Lion GateApplied",
      "analytics backend != decision authority",
      "artifact identity must remain provenance-bound"
    ]
  },
  "epistemic": {
    "status": "OBSERVED",
    "confidence": 0.9
  },
  "architecture_knowledge": {
    "schema_version": "1.0.0",
    "global_owner": "DonkeyJJLove/ai_platform",
    "semantic_exports": [
      "artifact_identity",
      "supply_chain_provenance",
      "composition_risk_evidence"
    ],
    "semantic_imports": [
      "architecture",
      "contracts",
      "currentness"
    ],
    "repository_dependencies": [
      "DonkeyJJLove/ai_platform"
    ],
    "architecture_artifacts": [
      {
        "path": "AGENTS.md",
        "class": "HUMAN_ARCHITECTURE_DOCUMENT",
        "currentness": "LOCAL_OWNER"
      },
      {
        "path": "AI_NATIVE_ROADMAP.md",
        "class": "ROADMAP",
        "currentness": "LOCAL_OWNER"
      },
      {
        "path": "PROCESS_GUARD.md",
        "class": "PROCESS_GUARD",
        "currentness": "LOCAL_OWNER"
      },
      {
        "path": "AID_CONTRACT.md",
        "class": "CONTRACT",
        "currentness": "LOCAL_OWNER"
      },
      {
        "path": "docs/01_AID_CONTRACT.md",
        "class": "HUMAN_ARCHITECTURE_DOCUMENT",
        "currentness": "LOCAL_OWNER"
      },
      {
        "path": "REPOSITORY_STANDARDIZATION_R1.json",
        "class": "MACHINE_READABLE_ARCHITECTURE",
        "currentness": "LOCAL_OWNER"
      }
    ],
    "discoverability": {
      "entrypoint": "AGENTS.md",
      "global_owner_route": "AGENTS.md -> cyber-lion.repository.json -> DonkeyJJLove/ai_platform:LION/architecture/v1_5/README.md",
      "max_reads_to_global_owner": 3
    },
    "invalidation_triggers": [
      "SOURCE_CHANGE",
      "CONTRACT_CHANGE",
      "CAPABILITY_CHANGE",
      "CURRENTNESS_CHANGE",
      "REPOSITORY_ROLE_CHANGE",
      "DEPENDENCY_CHANGE",
      "NAMING_STANDARD_CHANGE"
    ]
  }
}
